*.etl filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# Pre-existing binaries committed before LFS tracking existed for these extensions. Explicitly
# reverted to plain git storage so they don't appear spuriously "modified" (git-lfs's clean
# filter would otherwise produce a 132-byte pointer that doesn't match their already-committed
# raw-blob content) and so a careless `git add`/`git add -A` can't silently convert them to LFS
# pointers without the corresponding LFS objects ever being uploaded.
external/msdia140.dll -filter -diff -merge -text
external/arm64/msdia140.dll -filter -diff -merge -text
external/Microsoft.Diagnostics.Tracing.TraceEvent.SymbolsAuthentication.dll -filter -diff -merge -text
external/arm64/Microsoft.Diagnostics.Tracing.TraceEvent.SymbolsAuthentication.dll -filter -diff -merge -text
ProfileExplorerCoreTests/TestData/Binaries/MsoTrace/Mso20win32client.dll -filter -diff -merge -text
ProfileExplorerCoreTests/TestData/Symbols/MsoTrace/Mso20Win32Client.pdb -filter -diff -merge -text
