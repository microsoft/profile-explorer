<Window
  x:Class="ProfileExplorer.UI.Windows.AttachSpgoProfileWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Attach SPGO Profile"
  Width="700"
  MinWidth="560"
  Loaded="Window_Loaded"
  ResizeMode="CanResizeWithGrip"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  WindowStyle="ToolWindow">
  <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding WindowScaling}" ScaleY="{Binding WindowScaling}" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="16,8,16,0">
      <Label
        Padding="0,4"
        Content="_Target binary"
        Target="{Binding ElementName=TargetBinaryBox}" />
      <ComboBox
        x:Name="TargetBinaryBox"
        HorizontalContentAlignment="Stretch"
        SelectionChanged="TargetBinaryBox_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel ToolTip="{Binding FilePath}">
              <TextBlock Text="{Binding ModuleName}" />
              <TextBlock
                FontSize="11"
                Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                Text="{Binding FilePath}"
                TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock
        x:Name="TargetBinaryStatus"
        Margin="0,4,0,0"
        Text="Select a target binary."
        TextWrapping="Wrap" />

      <Label
        Margin="0,8,0,0"
        Padding="0,4"
        Content="Binary path"
        Target="{Binding ElementName=TargetBinaryPathBox}" />
      <TextBox
        x:Name="TargetBinaryPathBox"
        IsReadOnly="True"
        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

      <Label
        Margin="0,8,0,0"
        Padding="0,4"
        Content="SPGO _profile"
        Target="{Binding ElementName=ProfilePathBox}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="ProfilePathBox"
          IsReadOnly="True"
          ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Button
          Grid.Column="1"
          Margin="8,0,0,0"
          Padding="8,2"
          Click="ProfileBrowseButton_Click"
          Content="Browse..." />
      </Grid>

      <Label
        Margin="0,8,0,0"
        Padding="0,4"
        Content="P_DB (optional)"
        Target="{Binding ElementName=PdbPathBox}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          x:Name="PdbPathBox"
          ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Button
          Grid.Column="1"
          Margin="8,0,0,0"
          Padding="8,2"
          Click="PdbBrowseButton_Click"
          Content="Browse..." />
      </Grid>

      <Border
        Margin="0,16,0,0"
        Padding="8"
        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
        BorderThickness="1">
        <StackPanel>
          <TextBlock
            FontWeight="SemiBold"
            Text="Validation status: Not checked" />
          <TextBlock
            Margin="0,4,0,0"
            Text="Profile reading, compatibility validation, and attachment are not implemented yet. Selections are only kept in this dialog; the loaded session will not be changed."
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel
      Grid.Row="1"
      Margin="16"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        MinWidth="72"
        Margin="0,0,8,0"
        Padding="8,4"
        Content="Cancel"
        IsCancel="True" />
      <Button
        MinWidth="72"
        Padding="8,4"
        Content="Attach"
        IsEnabled="False"
        ToolTip="SPGO profile reading, validation, and attachment are not implemented yet"
        ToolTipService.ShowOnDisabled="True" />
    </StackPanel>
  </Grid>
</Window>
