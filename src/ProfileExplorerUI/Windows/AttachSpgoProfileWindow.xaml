<Window
  x:Class="ProfileExplorer.UI.Windows.AttachSpgoProfileWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Attach SPGO Profile"
  Width="700"
  MinWidth="560"
  Loaded="Window_Loaded"
  Closed="Window_Closed"
  ResizeMode="CanResizeWithGrip"
  ShowInTaskbar="False"
  SizeToContent="Height"
  SnapsToDevicePixels="True"
  UseLayoutRounding="True"
  MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
  WindowStartupLocation="CenterOwner"
  WindowStyle="ToolWindow">
  <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding WindowScaling}" ScaleY="{Binding WindowScaling}" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <ScrollViewer
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="InputsPanel" Margin="16,8,16,0">
        <Label
          Padding="0"
          Content="SPGO _profile file"
          Target="{Binding ElementName=ProfileBrowseButton}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="ProfilePathBox"
            Height="22"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            IsReadOnly="True"
            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <Button
            x:Name="ProfileBrowseButton"
            Grid.Column="1"
            Height="22"
            Margin="4,0,0,0"
            Padding="4,2,4,2"
            Click="ProfileBrowseButton_Click"
            Content="_Browse" />
        </Grid>

        <Label
          Margin="0,8,0,0"
          Padding="0"
          Content="_Target binary"
          Target="{Binding ElementName=TargetBinaryBox}" />
        <ComboBox
          x:Name="TargetBinaryBox"
          Height="22"
          Margin="0,4,0,0"
          HorizontalContentAlignment="Stretch"
          SelectionChanged="TargetBinaryBox_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Text="{Binding ModuleName}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{Binding FilePath}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding BinaryFileExists}" Value="True">
                          <Setter Property="Text" Value="{Binding BinaryFile.FilePath}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock
          x:Name="TargetBinaryStatus"
          Margin="0,4,0,0"
          Text="Select a target binary."
          TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="Medium"
            Text="Validation" />
          <Button
            x:Name="RetryButton"
            Grid.Column="1"
            Height="22"
            Padding="4,0,4,0"
            Click="RetryButton_Click"
            Content="Retry validation"
            Visibility="Collapsed" />
        </Grid>
        <ProgressBar
          x:Name="ValidationProgress"
          Height="4"
          Margin="0,4,0,0"
          IsIndeterminate="True"
          Visibility="Collapsed" />
        <TextBlock
          x:Name="ValidationStatus"
          Margin="0,4,0,0"
          Text="Select a profile to begin."
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="ValidationSummary"
          Margin="0,2,0,0"
          TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Expander
          x:Name="ValidationDetailsExpander"
          Margin="0,8,0,0"
          Header="Show details"
          IsExpanded="False"
          Visibility="Collapsed">
          <TextBox
            x:Name="ValidationDetails"
            MaxHeight="180"
            Margin="16,4,0,0"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        </Expander>

        <Expander
          x:Name="SymbolsToolsExpander"
          Margin="0,12,0,0"
          Header="Symbols and tools"
          IsExpanded="False"
          Visibility="Collapsed">
          <StackPanel Margin="16,4,0,0">
            <Label
              Padding="0"
              Content="P_DB (optional)"
              Target="{Binding ElementName=PdbPathBox}" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox
                x:Name="PdbPathBox"
                Height="22"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                TextChanged="PdbPathBox_TextChanged"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <Button
                Grid.Column="1"
                Height="22"
                Margin="4,0,0,0"
                Padding="4,2,4,2"
                Click="PdbBrowseButton_Click"
                Content="Browse" />
            </Grid>
            <Label
              Margin="0,8,0,0"
              Padding="0"
              Content="SPTDump _tool"
              Target="{Binding ElementName=ToolPathBox}" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox
                x:Name="ToolPathBox"
                Height="22"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                IsReadOnly="True"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <Button
                Grid.Column="1"
                Height="22"
                Margin="4,0,0,0"
                Padding="4,2,4,2"
                Click="ToolBrowseButton_Click"
                Content="Change..." />
              <Button
                Grid.Column="2"
                Height="22"
                Margin="4,0,0,0"
                Padding="4,2,4,2"
                Click="AutoDetectButton_Click"
                Content="Auto-detect" />
            </Grid>
          </StackPanel>
        </Expander>

        <TextBlock
          Margin="0,12,0,8"
          Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
          Text="SPT observations are shown in assembly columns. Profile data is retained for this session only."
          TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel
      Grid.Row="1"
      Margin="0,6,16,8"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        Height="24"
        Margin="0,0,4,0"
        Padding="4,0,4,0"
        Content="Cancel"
        IsCancel="True" />
      <Button
        x:Name="AttachButton"
        Height="24"
        Padding="4,0,4,0"
        Background="#FFFCF4CC"
        Content="Attach"
        IsEnabled="False"
        Click="AttachButton_Click"
        ToolTip="Show SPT observations beside assembly without changing existing ETL data"
        ToolTipService.ShowOnDisabled="True" />
    </StackPanel>
  </Grid>
</Window>
